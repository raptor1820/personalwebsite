<div class="site-cursor" id="site-cursor" aria-hidden="true">
  <span class="site-cursor-dot"></span>
</div>

<script is:inline>
  (() => {
    const siteCursor = document.getElementById("site-cursor");
    if (!siteCursor) return;

    const linkSelector = "a[href]";
    const linkTextSelector = ".link-text";

    const setCursorMode = (target) => {
      const text = target instanceof Element ? target.closest(linkTextSelector) : null;
      const link = text?.closest(linkSelector) ?? null;
      siteCursor.classList.toggle("is-link", Boolean(link));
    };

    const movePointer = (event) => {
      siteCursor.style.left = `${event.clientX}px`;
      siteCursor.style.top = `${event.clientY}px`;
      siteCursor.classList.add("is-visible");
      setCursorMode(event.target);
    };

    window.addEventListener("pointermove", movePointer, { passive: true });
    window.addEventListener("pointerover", (event) => setCursorMode(event.target), { passive: true });
    window.addEventListener(
      "pointerleave",
      () => {
        siteCursor.classList.remove("is-visible");
        siteCursor.classList.remove("is-link");
      },
      { passive: true }
    );
  })();
</script>

---
import "../styles/global.css";
import SiteCursor from "../components/SiteCursor.astro";
import SiteTheme from "../components/SiteTheme.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fff6e8" />
    <title>Page not found - Ritwic Verma</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SiteTheme />
  </head>
  <body>
    <SiteCursor />
    <main class="not-found-shell">
      <section class="not-found-panel" aria-labelledby="not-found-title">
        <p class="eyebrow">404</p>
        <h1 id="not-found-title">This page drifted.</h1>
        <p>The site is intentionally small, so the path you want is probably one step back.</p>
        <a class="action-link" href="/" target="_blank" rel="noopener noreferrer">
          <span class="link-text">return home</span>
        </a>
      </section>
    </main>
  </body>
</html>

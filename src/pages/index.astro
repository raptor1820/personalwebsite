---
import "../styles/global.css";
import SiteCursor from "../components/SiteCursor.astro";
import SiteSnake from "../components/SiteSnake.astro";
import SiteTheme from "../components/SiteTheme.astro";
import ThemePicker from "../components/ThemePicker.astro";

const canonicalUrl = "https://ritwic.com/";
const siteDescription =
  "Ritwic Verma is a computer science student at Georgia Tech building production AI systems, agent infrastructure, backend systems, full-stack software, and low-latency infrastructure.";

const summary = [
  "i build AI systems that go into production",
  "working across agents, backend and full stack systems"
];

const currently = [
  {
    text: "SDE Intern @ AWS Bedrock AgentCore",
    href: "https://aws.amazon.com/bedrock/agentcore/"
  },
  {
    text: "CS @ Georgia Tech: Intelligence and Info Internetworks",
    href: "https://www.gatech.edu/"
  },
  {
    text: "AI Infra Engineer @ AI Makerspace by NVIDIA",
    href: "https://alregib.ece.gatech.edu/ai-makerspace/"
  },
  {
    text: "TA for CS 3510: Design & Analysis of Algorithms",
    href: "https://faculty.cc.gatech.edu/~ladha/S26/3510/"
  }
];

const focus = [
  { text: "agentic workflows with tools, memory, routing, and evals" },
  { text: "infra for serving agents and models reliably on cloud and GPU clusters" },
  { text: "backend, full-stack, and low-latency systems" }
];

const recently = [
  { text: "working on secure agent handoff infrastructure at AWS" },
  { text: "built agentic AI workflows on NVIDIA H100 clusters with full observability" },
  { text: "full stack dev for GT Scheduler (30k+ users)", href: "https://www.gt-scheduler.org/" },
  { text: "built autonomous multi-agent systems across finance, medicine, and education" },
  { text: "taught algorithms to 500+ students as a TA" },
  { text: "remembered to play some snake :)" }
];

const links = [
  { label: "github", href: "https://github.com/raptor1820" },
  { label: "linkedin", href: "https://linkedin.com/in/ritwicverma" },
  { label: "email", href: "mailto:ritwicverma@gmail.com" }
];

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${canonicalUrl}#person`,
  name: "Ritwic Verma",
  url: canonicalUrl,
  email: "mailto:ritwicverma@gmail.com",
  description: siteDescription,
  jobTitle: [
    "Computer Science Student",
    "Software Development Engineer Intern",
    "AI Infrastructure Engineer",
    "Teaching Assistant"
  ],
  affiliation: [
    {
      "@type": "CollegeOrUniversity",
      name: "Georgia Institute of Technology",
      url: "https://www.gatech.edu/"
    },
    {
      "@type": "Organization",
      name: "AWS Bedrock AgentCore",
      url: "https://aws.amazon.com/bedrock/agentcore/"
    },
    {
      "@type": "Organization",
      name: "AI Makerspace by NVIDIA",
      url: "https://alregib.ece.gatech.edu/ai-makerspace/"
    }
  ],
  knowsAbout: [
    "AI infrastructure",
    "agentic workflows",
    "AI agents",
    "model serving",
    "backend systems",
    "full-stack software",
    "low-latency systems",
    "cloud infrastructure",
    "GPU clusters",
    "software engineering"
  ],
  sameAs: [
    "https://github.com/raptor1820",
    "https://linkedin.com/in/ritwicverma"
  ],
  mainEntityOfPage: canonicalUrl
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={siteDescription}
    />
    <meta name="author" content="Ritwic Verma" />
    <meta
      name="keywords"
      content="Ritwic Verma, Georgia Tech, AWS Bedrock AgentCore, AI infrastructure, agent infrastructure, AI agents, backend systems, full-stack software, low-latency systems, GPU clusters"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#fff6e8" />
    <meta property="og:title" content="Ritwic Verma" />
    <meta
      property="og:description"
      content={siteDescription}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <title>Ritwic Verma</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site summary" />
    <link rel="alternate" type="text/plain" href="/agents.txt" title="Agent guidance for ritwic.com" />
    <SiteTheme />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteCursor />

    <main class="page" id="content">
      <section class="home-card" aria-labelledby="intro-title">
        <header class="masthead">
          <nav class="nav" aria-label="Primary links">
            {links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer"><span class="link-text">{link.label}</span></a>)}
            <button id="site-snake-launch" type="button" aria-label="Play snake on this page">snake</button>
            <ThemePicker />
          </nav>
        </header>

        <div class="content-grid">
          <div class="intro">
            <h1 id="intro-title" class="hero-name" data-text="Ritwic Verma">Ritwic Verma</h1>
            <!-- <p class="role-line">cs major, builder, engineer</p> -->
            <ul class="summary-list" aria-label="Summary">
              {summary.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="lists" aria-label="Status lists">
            <section class="list-block" aria-labelledby="currently-heading">
              <h2 id="currently-heading">Currently:</h2>
              <ul>
                {
                  currently.map((item) => (
                    <li>
                      <span class="arrow" aria-hidden="true">↳</span>
                      <a href={item.href} target="_blank" rel="noopener noreferrer">
                        <span class="link-text">{item.text}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </section>

            <section class="list-block" aria-labelledby="building-heading">
              <h2 id="building-heading">Focus:</h2>
              <ul>
                {
                  focus.map((item) => (
                    <li>
                      <span class="arrow" aria-hidden="true">↳</span>
                      <span class="plain-row">
                        <strong>{item.text}</strong>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </section>

            <section class="list-block" aria-labelledby="recently-heading">
              <h2 id="recently-heading">Recently:</h2>
              <ul>
                {
                  recently.map((item) => (
                    <li>
                      <span class="arrow" aria-hidden="true">↳</span>
                      {
                        item.href ? (
                          <a href={item.href} target="_blank" rel="noopener noreferrer">
                            <span class="link-text">{item.text}</span>
                          </a>
                        ) : (
                          <span class="plain-row">
                            <span>{item.text}</span>
                          </span>
                        )
                      }
                    </li>
                  ))
                }
              </ul>
            </section>
          </div>
        </div>
      </section>
    </main>

    <SiteSnake />

  </body>
</html>
